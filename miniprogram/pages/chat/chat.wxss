}
.chat-page.dark-wallpaper .attach-btn {
  background: rgba(255, 255, 255, 0.08);
  border-color: rgba(255, 255, 255, 0.12);
}
.chat-page.dark-wallpaper .attach-btn text {
  color: rgba(255, 255, 255, 0.5);
}

/* ── Refined mode dark wallpaper overrides ── */
.chat-page.dark-wallpaper.card-mode .msg-blocks {
  background: rgba(40, 40, 40, 0.7);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-left-color: rgba(255, 255, 255, 0.15);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.2);
}
.chat-page.dark-wallpaper.card-mode .tool-card {
  background: transparent;
  border: none;
}
.chat-page.dark-wallpaper.card-mode .tool-card-header {
  background: transparent;
}
.chat-page.dark-wallpaper.card-mode .tool-group {
  background: transparent;
  border: none;
}
.chat-page.dark-wallpaper.card-mode .tool-group-header {
  background: transparent;
}

/* ── Animations ── */
@keyframes fade-in {
  from { opacity: 0; transform: translateY(-16rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to   { transform: rotate(360deg); }
}

/* ── Message selection mode ── */

.msg-checkbox {
  position: absolute;
  left: 12rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 3rpx solid #c9cdd4;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
  transition: all 0.15s ease;
  background: rgba(255,255,255,0.6);
}

.msg-checkbox.checked {
  border-color: var(--primary);
  background: var(--primary);
}

.msg-checkbox-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #fff;
}

.msg.msg-selecting {
  padding-left: 60rpx;
}

.msg.msg-selected {
  background: rgba(102, 126, 234, 0.06);
}

.msg {
  position: relative;
  transition: background 0.15s ease;
}

.select-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  flex-direction: column;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: var(--bg-base);
  border-top: 1rpx solid var(--border-2);
  z-index: 100;
}

.select-bar-info {
  text-align: center;
  font-size: 24rpx;
  color: var(--text-3);
  margin-bottom: 12rpx;
}

.select-bar-actions {
  display: flex;
  gap: 16rpx;
}

.select-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  border-radius: 36rpx;
  font-size: 26rpx;
  font-weight: 500;
}

.select-btn:active {
  opacity: 0.85;
}

.select-btn-all {
  background: var(--bg-2);
  color: var(--text-2);
}

.select-btn-share {
  background: var(--primary);
  color: #fff;
}

.select-btn-cancel {
  background: var(--bg-2);
  color: var(--text-3);
}
