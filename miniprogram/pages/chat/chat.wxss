/* ═══════════════════════════════════════════
   Chat page styles — AionUI-inspired design
   ═══════════════════════════════════════════ */

/* ── Page layout ── */
.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  position: relative;
  background: var(--bg-base);
}

/* ── Wallpaper layer ── */
.wallpaper-layer {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 0;
  background-size: cover;
  background-position: center;
}

.wallpaper-layer.paper { background: linear-gradient(180deg, #fefcf3 0%, #f5f0e8 100%); }
.wallpaper-layer.misty { background: linear-gradient(180deg, #e8ecf1 0%, #d5dee7 100%); }
.wallpaper-layer.peach { background: linear-gradient(135deg, #ffecd2 0%, #fcb69f 100%); }
.wallpaper-layer.night { background: linear-gradient(135deg, #232526 0%, #414345 100%); }

/* When wallpaper active, make overlays slightly transparent */
.chat-page.has-wallpaper .input-bar {
  background: rgba(255, 255, 255, 0.88);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}

.chat-page.has-wallpaper .image-preview-bar {
  background: rgba(255, 255, 255, 0.88);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}

/* Dark wallpaper: only override input bar */
.chat-page.dark-wallpaper .input-bar {
  background: rgba(30, 30, 30, 0.9);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-top-color: rgba(255, 255, 255, 0.1);
}

.chat-page.dark-wallpaper .input-field {
  background: rgba(255, 255, 255, 0.1);
  color: #fff;
}

.chat-messages {
  flex: 1;
  overflow-y: auto;
  padding: 20rpx 24rpx;
  padding-bottom: 40rpx;
  -webkit-overflow-scrolling: touch;
  position: relative;
  z-index: 1;
}

/* ── Fixed status bar (remote, queue) ── */
.fixed-status-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 20;
  background: var(--bg-base);
  border-bottom: 1rpx solid var(--border-1);
  padding: 8rpx 0;
}

.chat-messages.has-status-bar {
  padding-top: 70rpx;
}

.load-more-tip {
  text-align: center;
  padding: 16rpx 0;
  color: var(--text-3, #999);
  font-size: 24rpx;
}

/* ── Status lines (remote, queue) ── */
.status-line {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 16rpx 0;
  margin-bottom: 12rpx;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.status-dot-warning {
  background: var(--warning);
  animation: blink 2s ease-in-out infinite;
}

.status-dot-muted {
  background: var(--text-4);
}

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.3; }
}

.status-text {
  font-size: 22rpx;
  color: var(--text-3);
}

/* Refined: status/event pill style */
.chat-page.card-mode .status-line {
  background: var(--bg-2);
  border-radius: 20rpx;
  padding: 8rpx 24rpx;
}

/* ═══════════════════════════════════
   Messages
   ═══════════════════════════════════ */
.msg {
  margin-bottom: 24rpx;
  padding: 0 16rpx;
  box-sizing: border-box;
}

.msg.user {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  padding: 0 24rpx 0 0;
}

.msg.agent {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 0 40rpx 0 16rpx;
}

/* ── Agent message blocks container ── */
.msg-blocks {
  max-width: 100%;
  width: 100%;
  overflow: hidden;
}

/* Card mode: agent messages get card background */
.chat-page.card-mode .msg-blocks {
  background: rgba(255, 255, 255, 0.45);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-radius: 16rpx 4rpx 16rpx 16rpx;
  border-left: 5rpx solid #d4d0c8;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
  margin: 8rpx 0;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.chat-page.card-mode .msg-bubble {
  border-radius: 20rpx 4rpx 20rpx 20rpx;
  padding: 18rpx 28rpx;
  background: rgba(255, 255, 255, 0.88);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
}

/* ── Agent text content with copy button ── */
.msg-text-block {
  position: relative;
}

.msg-content {
  max-width: 100%;
  overflow: hidden;
}

.msg.agent .msg-content > view {
  margin-bottom: 8rpx;
}

.msg-text {
  font-size: 28rpx;
  line-height: 1.75;
  color: var(--text-1);
  word-break: break-word;
}

.msg-heading {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-1);
  margin-top: 20rpx;
  margin-bottom: 8rpx;
  line-height: 1.5;
}

/* ── Markdown table ── */
.msg-table {
  width: 100%;
  margin: 12rpx 0;
  overflow-x: auto;
}

.msg-list-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding-left: 16rpx;
  margin: 4rpx 0;
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--text-1);
}

.list-dot {
  color: var(--text-3);
  flex-shrink: 0;
  margin-top: 2rpx;
}

.list-text {
  flex: 1;
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--text-1);
}

/* ── Code blocks ── */
.code-block {
  background: #f6f8fa;
  border-radius: 12rpx;
  margin: 16rpx 0;
  overflow: hidden;
}

.code-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 20rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.code-lang {
  font-size: 22rpx;
  font-family: 'SF Mono', Menlo, Monaco, 'Courier New', monospace;
  color: var(--text-3);
}

.code-text {
  padding: 20rpx;
  overflow-x: auto;
}

.code-text text {
  font-size: 24rpx;
  font-family: 'SF Mono', Menlo, Monaco, 'Courier New', monospace;
  line-height: 1.6;
  color: var(--text-1);
  white-space: pre-wrap;
  word-break: break-all;
}

/* ═══════════════════════════════════
   Thinking block (in-message, AionUI style)
   ═══════════════════════════════════ */
.thinking-block {
  width: 100%;
}

.thinking-block-divider {
  border: none;
  border-top: 1rpx solid var(--border-2);
  margin: 8rpx 0;
}

.thinking-block-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 6rpx 0;
  cursor: pointer;
}

.thinking-block-arrow {
  width: 0;
  height: 0;
  border-left: 10rpx solid var(--text-3);
  border-top: 6rpx solid transparent;
  border-bottom: 6rpx solid transparent;
  transition: transform 0.2s ease;
  flex-shrink: 0;
}

.thinking-block-arrow.expanded {
  transform: rotate(90deg);
}

.thinking-block-summary {
  font-size: 22rpx;
  color: var(--text-3);
  font-style: italic;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
}

.thinking-block-body {
  color: var(--text-3);
  font-style: italic;
  font-size: 24rpx;
  line-height: 1.6;
  padding: 8rpx 0;
  white-space: pre-wrap;
  word-break: break-word;
  overflow: hidden;
}

/* ═══════════════════════════════════
   Tool group — "View Steps" aggregation
   ═══════════════════════════════════ */
.tool-group {
  margin: 12rpx 0;
}

/* Refined: tool group card styling */
.chat-page.card-mode .tool-group {
  background: transparent;
  border: none;
  border-radius: 0;
  overflow: visible;
  box-shadow: none;
  margin: 8rpx 0;
}

.chat-page.card-mode .tool-group-header {
  background: transparent;
  border-radius: 0;
}

.tool-group-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 16rpx;
  cursor: pointer;
  transition: opacity 0.15s ease;
}

.tool-group-header:active {
  opacity: 0.7;
}

.tool-group-icon {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--bg-4);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.tool-group-icon text {
  font-size: 20rpx;
  font-weight: 600;
  color: var(--text-3);
}

.tool-group-label {
  font-size: 24rpx;
  color: var(--text-3);
  font-weight: 500;
  flex: 1;
}

.tool-group-body {
  padding: 8rpx 0 8rpx 20rpx;
  border-left: 2rpx solid var(--border-2);
  margin-left: 16rpx;
  margin-top: 8rpx;
  animation: expand-fade 0.2s ease-out;
}

.tool-group-item {
  display: flex;
  flex-direction: column;
}

.tool-group-item + .tool-group-item {
  margin-top: 8rpx;
}

.tool-group-item-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 12rpx;
  border-radius: 8rpx;
  cursor: pointer;
  transition: background 0.15s ease;
}

.tool-group-item-header:active {
  background: var(--bg-2);
}

.tool-group-item-body {
  padding: 8rpx 12rpx 12rpx;
  animation: expand-fade 0.2s ease-out;
}

/* ═══════════════════════════════════
   Tool call cards (enhanced)
   ═══════════════════════════════════ */
.tool-card {
  margin: 8rpx 0;
  background: transparent;
  border: none;
  border-radius: 0;
  overflow: visible;
}

/* Refined: tool card styling — keep transparent */
.chat-page.card-mode .tool-card {
  background: transparent;
  border: none;
  border-radius: 0;
  overflow: visible;
  box-shadow: none;
  margin: 8rpx 0;
}

.chat-page.card-mode .tool-card-header {
  background: transparent;
  border-radius: 0;
}

.tool-card.running {
}

.tool-card.completed {
}

.tool-card.expanded {
}

.tool-card-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 20rpx;
  min-height: 40rpx;
}

/* ── CSS status dots (replacing emoji) ── */
.tool-status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
  transition: background 0.2s ease;
}

/* Refined: larger status dot with container */
.chat-page.card-mode .tool-status-dot {
  width: 20rpx;
  height: 20rpx;
}

.tool-status-dot.running {
  background: var(--primary);
  animation: dot-breathing 1.5s ease-in-out infinite;
}

.tool-status-dot.completed {
  background: var(--success);
}

.tool-status-dot.approved {
  background: var(--success);
}

.tool-status-dot.error {
  background: var(--danger);
}

@keyframes dot-breathing {
  0%, 100% { opacity: 0.4; transform: scale(0.85); }
  50% { opacity: 1; transform: scale(1); }
}

.tool-name {
  font-size: 24rpx;
  font-family: 'SF Mono', Menlo, Monaco, 'Courier New', monospace;
  font-weight: 500;
  color: var(--text-2);
  flex-shrink: 0;
}

/* ── Parameter summary (compact) ── */
.tool-param-summary {
  font-size: 22rpx;
  font-family: 'SF Mono', Menlo, Monaco, 'Courier New', monospace;
  color: var(--text-3);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
  min-width: 0;
}

.tool-param-summary.expanded {
  white-space: normal;
  word-break: break-all;
  text-overflow: unset;
}

.tool-preview-btn {
  font-size: 22rpx;
  color: var(--primary);
  background: var(--bg-base);
  border: 1rpx solid var(--primary);
  border-radius: 8rpx;
  padding: 4rpx 16rpx;
  flex-shrink: 0;
  margin-left: auto;
}

.tool-preview-btn:active {
  opacity: 0.6;
}

.tool-chevron {
  width: 0;
  height: 0;
  border-left: 8rpx solid var(--text-4);
  border-top: 6rpx solid transparent;
  border-bottom: 6rpx solid transparent;
  flex-shrink: 0;
  transition: transform 0.2s ease;
}

.tool-chevron.up {
  transform: rotate(90deg);
}

.tool-chevron.down {
  transform: rotate(0deg);
}

.tool-card-body {
  padding: 0 20rpx 16rpx;
  animation: expand-fade 0.2s ease-out;
}

@keyframes expand-fade {
  from { opacity: 0; transform: translateY(-8rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ── Input display in expanded tool card ── */
.tool-input-display {
  margin-top: 12rpx;
  padding: 10rpx 16rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.tool-input-label {
  font-size: 20rpx;
  color: var(--text-4);
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

.tool-input-text {
  font-size: 22rpx;
  font-family: 'SF Mono', Menlo, Monaco, 'Courier New', monospace;
  color: var(--text-2);
  line-height: 1.5;
  word-break: break-all;
  white-space: pre-wrap;
}

/* ── Tool result with collapsible gradient mask ── */
.tool-result-wrapper {
  margin-top: 12rpx;
}

.tool-result {
  border-radius: 10rpx;
  padding: 16rpx 20rpx;
  position: relative;
  overflow: hidden;
  transition: max-height 0.3s ease;
}

.tool-result-collapsed {
  max-height: 240rpx;
}

.tool-result-mask {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 80rpx;
  background: linear-gradient(to bottom, rgba(246, 248, 250, 0), rgba(246, 248, 250, 0.6) 40%, rgba(246, 248, 250, 0.95) 80%, rgba(246, 248, 250, 1) 100%);
  pointer-events: none;
}

.tool-result text {
  font-size: 24rpx;
  font-family: 'SF Mono', Menlo, Monaco, 'Courier New', monospace;
  color: var(--text-2);
  line-height: 1.5;
  white-space: pre-wrap;
  word-break: break-all;
}

.tool-result.error {
  background: var(--danger-bg);
  border: 1rpx solid rgba(245, 63, 63, 0.12);
}

.tool-result.error text {
  color: var(--danger);
}

.tool-result.error .tool-result-mask {
  background: linear-gradient(to bottom, rgba(255, 236, 236, 0), rgba(255, 236, 236, 0.6) 40%, rgba(255, 236, 236, 0.95) 80%, rgba(255, 236, 236, 1) 100%);
}

.tool-result-toggle {
  display: flex;
  justify-content: center;
  padding: 12rpx 0 4rpx;
}

.tool-result-toggle text {
  font-size: 22rpx;
  color: var(--primary);
  font-weight: 500;
}

.tool-result-toggle:active text {
  opacity: 0.7;
}

/* ── Diff view ── */
.diff-view {
  margin-top: 12rpx;
  border-radius: 10rpx;
  overflow: hidden;
  border: 1rpx solid var(--border-1);
}

.diff-file {
  padding: 10rpx 16rpx;
  background: #f1f5f9;
  font-size: 22rpx;
  font-family: 'SF Mono', Menlo, Monaco, 'Courier New', monospace;
  color: var(--text-2);
  border-bottom: 1rpx solid var(--border-1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.diff-content {
  padding: 8rpx 0;
  display: flex;
  flex-direction: column;
}

.diff-line {
  font-size: 22rpx;
  font-family: 'SF Mono', Menlo, Monaco, 'Courier New', monospace;
  padding: 3rpx 16rpx;
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-all;
}

.diff-line-old {
  color: #b91c1c;
  background: rgba(254, 226, 226, 0.6);
}

.diff-line-new {
  color: #15803d;
  background: rgba(220, 252, 231, 0.6);
}

/* ═══════════════════════════════════
   Permission / AskUserQuestion card
   ═══════════════════════════════════ */
.perm-card {
  background: var(--warning-bg);
  border: 1rpx solid rgba(255, 125, 0, 0.15);
  border-radius: var(--r-lg);
  padding: 24rpx;
  margin: 12rpx 0;
  max-width: 85%;
  animation: fade-in 0.25s ease-out;
  box-sizing: border-box;
}

.perm-title {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--warning);
  text-transform: uppercase;
  letter-spacing: 1rpx;
  margin-bottom: 12rpx;
}

.perm-detail {
  font-size: 24rpx;
  color: var(--text-2);
  margin-bottom: 24rpx;
  font-family: 'SF Mono', Menlo, Monaco, 'Courier New', monospace;
  background: var(--bg-2);
  padding: 16rpx 20rpx;
  border-radius: var(--r-sm);
  line-height: 1.5;
  word-break: break-all;
}

.perm-questions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.perm-question {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.perm-question-header {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-1);
}

.perm-question-text {
  font-size: 26rpx;
  color: var(--text-2);
  line-height: 1.5;
}

.perm-options {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 4rpx;
}

.perm-option {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 14rpx 16rpx;
  background: var(--bg-base);
  border: 1rpx solid var(--border-1);
  border-radius: var(--r-md);
  transition: border-color 0.15s ease, background 0.15s ease;
}

.perm-option:active {
  background: var(--bg-hover);
}

.perm-option.selected {
  border-color: var(--primary);
  background: var(--primary-bg);
}

.perm-radio {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 4rpx solid var(--bg-4);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 4rpx;
  transition: border-color 0.15s ease;
  box-sizing: border-box;
}

.perm-radio.checked {
  border-color: var(--primary);
}

.perm-radio-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--primary);
}

.perm-option-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  overflow: hidden;
}

.perm-option-label {
  font-size: 26rpx;
  color: var(--text-1);
  font-weight: 500;
}

.perm-option-desc {
  font-size: 22rpx;
  color: var(--text-3);
  line-height: 1.4;
}

.perm-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
}

.perm-btn {
  flex: 1;
  font-size: 26rpx;
  font-weight: 600;
  padding: 18rpx 0;
  border-radius: var(--r-md);
  border: none;
  text-align: center;
  transition: transform 0.1s ease;
}

.perm-btn:active {
  transform: scale(0.97);
}

.perm-btn-allow {
  background: #fff;
  color: #00a856;
  border: 1rpx solid rgba(0, 168, 86, 0.2);
}

.perm-btn-deny {
  background: var(--bg-base);
  color: var(--danger);
  border: 1rpx solid rgba(245, 63, 63, 0.2);
}

.perm-btn-deny:active {
  background: var(--danger-bg);
}

/* ═══════════════════════════════════
   Copy button (agent messages)
   ═══════════════════════════════════ */
.msg-copy-btn {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 8rpx;
  background: var(--bg-2);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.2s ease;
}

.msg-text-block:active .msg-copy-btn,
.msg-copy-btn:active {
  opacity: 1;
}

.copy-icon {
  width: 20rpx;
  height: 24rpx;
  border: 3rpx solid var(--text-3);
  border-radius: 3rpx;
  position: relative;
}

.copy-icon::after {
  content: '';
  position: absolute;
  top: -6rpx;
  left: -6rpx;
  width: 20rpx;
  height: 24rpx;
  border: 3rpx solid var(--text-3);
  border-radius: 3rpx;
  border-bottom: none;
  border-right: none;
}

/* ═══════════════════════════════════
   User message
   ═══════════════════════════════════ */
.msg-bubble-wrapper {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  max-width: 85%;
  margin-right: 24rpx;
}

.msg-bubble {
  max-width: 100%;
  padding: 18rpx 24rpx;
  font-size: 28rpx;
  line-height: 1.7;
  word-break: break-word;
  box-sizing: border-box;
  background: var(--bg-2);
  border-radius: 20rpx 6rpx 20rpx 20rpx;
  color: var(--text-1);
}

.msg-attachments {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.msg-image {
  width: 280rpx;
  border-radius: var(--r-md);
  background: var(--bg-2);
}

/* ═══════════════════════════════════
   Timestamp (tap to show/hide)
   ═══════════════════════════════════ */
.msg-time {
  font-size: 20rpx;
  color: var(--text-4);
  padding: 0 8rpx;
  height: 0;
  opacity: 0;
  overflow: hidden;
  transition: opacity 0.2s ease;
  margin-top: 0;
}

.msg-time.visible {
  height: auto;
  opacity: 1;
  margin-top: 6rpx;
  padding-bottom: 4rpx;
}

/* ═══════════════════════════════════
   Thinking indicator (enhanced)
   ═══════════════════════════════════ */
.thinking {
  display: flex;
  align-items: center;
  padding: 16rpx 8rpx;
}

.thinking-indicator {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 20rpx;
  background: linear-gradient(90deg, rgba(240, 243, 255, 0.8) 0%, rgba(242, 242, 242, 0.8) 100%);
  border-radius: 20rpx 6rpx 20rpx 20rpx;
}

.thinking-dots {
  display: flex;
  gap: 8rpx;
}

.thinking-dots view {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--primary);
  animation: breathing 1.5s ease-in-out infinite;
}

.thinking-dots view:nth-child(2) { animation-delay: 0.2s; }
.thinking-dots view:nth-child(3) { animation-delay: 0.4s; }

@keyframes breathing {
  0%, 100% { opacity: 0.4; transform: scale(0.85); }
  50% { opacity: 1; transform: scale(1); }
}

.thinking-text {
  font-size: 24rpx;
  color: var(--text-2);
  font-weight: 500;
}

.thinking-timer {
  font-size: 22rpx;
  color: var(--text-3);
  font-family: 'SF Mono', Menlo, Monaco, 'Courier New', monospace;
  min-width: 36rpx;
}

/* ── Compact progress bar ── */
.compact-bar {
  position: relative;
  margin: 16rpx 24rpx;
  height: 48rpx;
  background: var(--bg-2);
  border-radius: 12rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.compact-progress {
  position: absolute;
  top: 0; left: 0; bottom: 0;
  background: rgba(102, 126, 234, 0.12);
  border-radius: 12rpx;
  transition: width 0.3s ease;
}

.compact-text {
  position: relative;
  font-size: 24rpx;
  color: var(--text-3);
  font-weight: 500;
}

/* ═══════════════════════════════════
   Input bar
   ═══════════════════════════════════ */

.input-field {
  flex: 1;
  background: var(--bg-2);
  border: 2rpx solid var(--border-1);
  border-radius: 32rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
  color: var(--text-1);
  min-height: 48rpx;
  max-height: 240rpx;
  line-height: 1.5;
  box-sizing: border-box;
}

/* ── Input area (fixed, transform via inline style) ── */
.input-area {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 10;
}

.input-bar {
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: var(--bg-base);
  border-top: 1rpx solid var(--border-2);
  box-sizing: border-box;
}

/* ── YOLO toggle (left of textarea) ── */
.yolo-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: var(--bg-2);
  border: 2rpx solid var(--border-1);
  transition: background 0.15s ease, border-color 0.15s ease;
}

.yolo-btn:active { transform: scale(0.92); }

.yolo-btn .yolo-label {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-3);
  line-height: 1;
}

.yolo-btn.active {
  background: rgba(245, 63, 63, 0.1);
  border-color: rgba(245, 63, 63, 0.3);
}

.yolo-btn.active .yolo-label {
  color: #f53f3f;
}

/* ── Inline bar buttons (abort / send / expand) ── */
.bar-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: transform 0.1s ease;
}

.bar-btn:active {
  transform: scale(0.92);
}

/* Expand (+) button */
.expand-btn {
  background: var(--bg-2);
  border: 2rpx solid var(--border-1);
  transition: transform 0.3s ease, background 0.15s ease;
}

.expand-btn text {
  font-size: 40rpx;
  font-weight: 300;
  color: var(--text-3);
  line-height: 1;
  margin-top: -4rpx;
}

.expand-btn.active {
  transform: rotate(45deg);
  background: var(--bg-hover);
}

/* Send button (inline) */
.send-btn {
  background: var(--primary);
}

.send-btn.disabled {
  background: var(--bg-3);
}

/* Send arrow icon */
.send-arrow {
  position: relative;
  width: 4rpx;
  height: 18rpx;
  background: #fff;
  border-radius: 2rpx;
}

.send-arrow::before {
  content: '';
  position: absolute;
  top: 0;
  left: 50%;
  width: 12rpx;
  height: 12rpx;
  border-left: 4rpx solid #fff;
  border-top: 4rpx solid #fff;
  transform: translate(-50%, -2rpx) rotate(45deg);
}

.send-btn.disabled .send-arrow {
  background: #999;
}

.send-btn.disabled .send-arrow::before {
  border-color: #999;
}

/* Abort button (inline) */
.abort-btn {
  background: var(--danger-bg);
  border: 2rpx solid rgba(245, 63, 63, 0.2);
}

.abort-icon {
  width: 20rpx;
  height: 20rpx;
  background: var(--danger);
  border-radius: 4rpx;
}

.abort-btn.loading .abort-icon {
  animation: spin 1s linear infinite;
}

/* ── Action panel (separate fixed at bottom) ── */
.action-panel-fixed {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 9;
  background: #f7f8fa;
  border-top: 1rpx solid var(--border-2);
  animation: slide-up-panel 0.25s ease-out;
}

@keyframes slide-up-panel {
  from { transform: translateY(100%); }
  to   { transform: translateY(0); }
}

.action-row {
  display: flex;
  gap: 40rpx;
  justify-content: flex-start;
  padding: 24rpx 40rpx calc(24rpx + env(safe-area-inset-bottom));
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.action-item:active { opacity: 0.7; }

.action-icon-circle {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-icon-image { background: rgba(56, 136, 255, 0.1); }
.action-icon-shortcut { background: rgba(232, 133, 61, 0.1); }
.action-icon-export { background: rgba(102, 126, 234, 0.1); }
.action-icon-yolo { background: rgba(245, 63, 63, 0.08); }
.action-icon-yolo.active { background: rgba(245, 63, 63, 0.15); }

.aicon-yolo-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #f53f3f;
}

/* Image icon */
.aicon-img {
  width: 34rpx; height: 28rpx;
  border: 3rpx solid #3888ff;
  border-radius: 6rpx;
  position: relative;
}
.aicon-img::after {
  content: '';
  position: absolute;
  top: 6rpx; left: 50%;
  width: 8rpx; height: 8rpx;
  border-radius: 50%;
  background: #3888ff;
  transform: translateX(-50%);
}

/* Shortcut (lightning) icon */
.aicon-zap {
  width: 0; height: 0;
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-bottom: 18rpx solid #e8853d;
  position: relative;
}
.aicon-zap::after {
  content: '';
  position: absolute;
  top: 18rpx; left: -10rpx;
  width: 0; height: 0;
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-top: 18rpx solid #e8853d;
}

/* Export (share) icon */
.aicon-share {
  width: 20rpx; height: 20rpx;
  border: 3rpx solid #667eea;
  border-radius: 4rpx;
  position: relative;
}
.aicon-share::after {
  content: '';
  position: absolute;
  bottom: 100%;
  left: 50%;
  transform: translateX(-50%);
  width: 0; height: 0;
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  border-bottom: 10rpx solid #667eea;
}

.action-text {
  font-size: 22rpx;
  color: var(--text-3);
  white-space: nowrap;
}

/* ── Shortcut popup ── */
.sc-popup {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 50;
}

.sc-popup-inner {
  position: absolute;
  left: 16rpx; right: 16rpx; bottom: 200rpx;
  background: #ffffff;
  border: 1rpx solid #f2f3f5;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
  max-height: 420rpx;
  overflow-y: auto;
}

.sc-popup-empty {
  padding: 32rpx;
  text-align: center;
}

.sc-popup-empty-text {
  font-size: 26rpx; color: #c9cdd4;
}

.sc-popup-name {
  font-size: 28rpx; color: #1d2129; font-weight: 500;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  display: block;
}

/* ── Shortcut CRUD ── */
.sc-popup-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  border-bottom: 0.5rpx solid #f2f3f5;
}

.sc-popup-item:last-of-type { border-bottom: none; }
.sc-popup-item:active { background: #f9fafb; }

.sc-item-info { flex: 1; min-width: 0; }
.sc-item-actions { display: flex; gap: 12rpx; flex-shrink: 0; margin-left: 16rpx; }

.sc-item-btn {
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  background: var(--bg-2);
}

.sc-item-btn-text { font-size: 22rpx; color: var(--text-3); }
.sc-item-btn-danger .sc-item-btn-text { color: #f53f3f; }

.sc-form { padding: 24rpx; }
.sc-input {
  font-size: 28rpx;
  padding: 16rpx 20rpx;
  height: 72rpx;
  line-height: 40rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  width: 100%;
  box-sizing: border-box;
}
.sc-textarea {
  font-size: 26rpx;
  padding: 16rpx 20rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  width: 100%;
  box-sizing: border-box;
  min-height: 120rpx;
}
.sc-form-actions {
  display: flex;
  gap: 16rpx;
  justify-content: flex-end;
  margin-top: 16rpx;
}
.sc-btn-cancel {
  font-size: 26rpx;
  color: var(--text-3);
  padding: 12rpx 32rpx;
  border-radius: 10rpx;
  background: var(--bg-2);
}
.sc-btn-save {
  font-size: 26rpx;
  color: #fff;
  padding: 12rpx 32rpx;
  border-radius: 10rpx;
  background: #667eea;
}
.sc-add {
  padding: 20rpx 24rpx;
  border-top: 0.5rpx solid #f2f3f5;
  text-align: center;
}
.sc-add-text {
  font-size: 26rpx;
  color: #667eea;
  font-weight: 500;
}

/* ── Image preview bar ── */
.image-preview-bar {
  position: fixed;
  bottom: 200rpx;
  bottom: calc(200rpx + env(safe-area-inset-bottom));
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  background: var(--bg-1);
  border-top: 1rpx solid var(--border-2);
  z-index: 9;
  animation: slide-up-preview 0.2s ease-out;
}

@keyframes slide-up-preview {
  from { opacity: 0; transform: translateY(20rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

.preview-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--r-md);
  background: var(--bg-2);
}

.preview-remove {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  line-height: 1;
}

/* ═══════════════════════════════════
   Wallpaper-aware color overrides
   ═══════════════════════════════════ */

/* ── Light wallpapers (paper / misty / peach / custom): semi-transparent overlays ── */
.chat-page.has-wallpaper .code-block {
  background: rgba(255, 255, 255, 0.35);
}
.chat-page.has-wallpaper .code-header {
  border-bottom-color: rgba(0, 0, 0, 0.04);
}
.chat-page.has-wallpaper .diff-file {
  background: rgba(255, 255, 255, 0.4);
}
.chat-page.has-wallpaper .tool-result {
  background: transparent;
}
.chat-page.has-wallpaper .tool-result-mask {
  background: linear-gradient(to bottom, transparent, rgba(255, 255, 255, 0.85) 100%);
}
.chat-page.has-wallpaper .tool-result.error .tool-result-mask {
  background: linear-gradient(to bottom, rgba(255, 236, 236, 0), rgba(255, 236, 236, 0.95) 100%);
}
.chat-page.has-wallpaper .diff-line-old {
  background: rgba(254, 226, 226, 0.35);
}
.chat-page.has-wallpaper .diff-line-new {
  background: rgba(220, 252, 231, 0.35);
}
.chat-page.has-wallpaper .thinking-indicator {
  background: linear-gradient(90deg, rgba(240, 243, 255, 0.4) 0%, rgba(242, 242, 242, 0.4) 100%);
}
.chat-page.has-wallpaper .msg-bubble {
  background: rgba(255, 255, 255, 0.55);
}
.chat-page.has-wallpaper .msg-copy-btn {
  background: rgba(255, 255, 255, 0.5);
}

