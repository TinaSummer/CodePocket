.guide-page {
  min-height: 100vh;
  background: #f9fafb;
  padding: 32rpx 36rpx 60rpx;
  box-sizing: border-box;
}

/* Sections */
.guide-section {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.section-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.section-num {
  width: 40rpx; height: 40rpx; border-radius: 50%;
  background: rgba(102, 126, 234, 0.12); color: #667eea;
  font-size: 22rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}

.section-title {
  font-size: 30rpx; font-weight: 700; color: #1d2129;
}

.guide-hint {
  font-size: 26rpx; color: #4e5969; display: block;
  line-height: 1.7; margin-bottom: 12rpx;
}

/* Command boxes */
.cmd-group { margin-bottom: 16rpx; }
.cmd-label {
  font-size: 22rpx; color: #86909c; display: block; margin-bottom: 6rpx;
}
.cmd-box {
  background: #1d2129; border-radius: 12rpx; padding: 20rpx 24rpx;
  display: flex; align-items: center; gap: 16rpx;
}
.cmd-text {
  flex: 1; font-size: 22rpx; font-family: Menlo, Monaco, monospace;
  color: #e5e6eb; line-height: 1.5; word-break: break-all;
}
.cmd-copy {
  font-size: 22rpx; font-weight: 600; color: #667eea; flex-shrink: 0;
  padding: 6rpx 16rpx; background: rgba(102, 126, 234, 0.15); border-radius: 8rpx;
}

/* Download table */
.download-table {
  background: #f7f8fa; border-radius: 12rpx;
  overflow: hidden; margin: 12rpx 0;
}
.table-header {
  display: flex; padding: 16rpx 20rpx;
  background: rgba(102, 126, 234, 0.06);
}
.table-row {
  display: flex; padding: 14rpx 20rpx;
  border-top: 0.5rpx solid #f2f3f5;
}
.th-name, .td-name { width: 140rpx; font-size: 22rpx; flex-shrink: 0; }
.th-file, .td-file { flex: 1; font-size: 22rpx; }
.th-desc, .td-desc { width: 160rpx; font-size: 22rpx; flex-shrink: 0; }
.th-name, .th-file, .th-desc { font-weight: 600; color: #1d2129; }
.td-name { color: #1d2129; font-weight: 500; }
.td-file { color: #667eea; font-family: Menlo, Monaco, monospace; font-size: 20rpx; }
.td-desc { color: #86909c; }

/* Footer */
.guide-footer {
  text-align: center; padding: 20rpx 0 40rpx;
}
.footer-text {
  font-size: 24rpx; color: #86909c; display: block; margin-bottom: 24rpx;
}
.contact-btn {
  display: inline-block;
  background: #667eea; color: #fff; font-size: 28rpx; font-weight: 500;
  padding: 16rpx 48rpx; border-radius: 12rpx; line-height: 1.5;
  border: none;
}
.contact-btn::after { border: none; }
