.setup-page {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  min-height: 100vh; padding: 0 48rpx;
  background: linear-gradient(160deg, #b8c6db 0%, #a0b4d0 40%, #8da4c4 100%);
}

.setup-card {
  width: 100%; max-width: 600rpx;
  background: rgba(255, 255, 255, 0.98);
  border-radius: 40rpx;
  padding: 56rpx 40rpx 44rpx;
  box-shadow: 0 16px 64rpx rgba(0, 0, 0, 0.18);
}

.setup-brand {
  display: flex; flex-direction: column; align-items: center; margin-bottom: 44rpx;
}

.setup-logo {
  width: 120rpx; height: 120rpx; border-radius: 28rpx;
  display: block; margin: 0 auto 20rpx;
}

.setup-title {
  font-size: 40rpx; font-weight: 700;
  background: linear-gradient(135deg, #5b8af5, #7c6dd8);
  -webkit-background-clip: text; color: transparent;
}

.setup-subtitle { font-size: 24rpx; color: #86909c; margin-top: 8rpx; }

/* ── Guide ── */
.guide-toggle {
  display: flex; align-items: center; justify-content: space-between;
  padding: 16rpx 0; border-top: 0.5rpx solid #f2f3f5; margin-top: 8rpx;
}
.guide-toggle-text { font-size: 26rpx; font-weight: 600; color: #4e5969; }
.guide-toggle-arrow { font-size: 20rpx; color: #86909c; }

.guide-content {
  padding: 12rpx 0 16rpx; border-bottom: 0.5rpx solid #f2f3f5;
}
.guide-section { margin-bottom: 16rpx; }
.guide-section:last-child { margin-bottom: 0; }
.guide-label {
  font-size: 22rpx; font-weight: 600; color: #667eea;
  background: rgba(102, 126, 234, 0.08); border-radius: 6rpx;
  padding: 2rpx 12rpx; margin-bottom: 8rpx; display: inline-block;
}
.guide-text { font-size: 22rpx; color: #4e5969; display: block; line-height: 1.6; }
.guide-step { font-size: 22rpx; color: #4e5969; display: block; line-height: 1.8; }

.setup-steps { display: flex; flex-direction: column; gap: 28rpx; }

.guide-contact-btn {
  display: inline-block;
  background: #667eea; color: #fff; font-size: 24rpx; font-weight: 500;
  padding: 10rpx 36rpx; border-radius: 10rpx; line-height: 1.5;
  border: none; margin: 0;
}
.guide-contact-btn::after { border: none; }

.setup-step { display: flex; gap: 20rpx; align-items: flex-start; }

.step-num {
  width: 40rpx; height: 40rpx; border-radius: 50%;
  background: #f2f3f5; color: #86909c;
  font-size: 22rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.step-num.active { background: rgba(102, 126, 234, 0.12); color: #667eea; }
.step-num.done { background: rgba(0, 180, 42, 0.12); color: #00b42a; }

.step-content { flex: 1; }
.step-title { display: block; font-size: 26rpx; font-weight: 600; color: #1d2129; margin-bottom: 8rpx; }
.step-hint { font-size: 22rpx; color: #86909c; line-height: 1.5; }

.command-box {
  background: #1d2129; border-radius: 14rpx; padding: 20rpx 24rpx; margin-top: 8rpx;
  display: flex; align-items: center; gap: 16rpx;
}
.command-text {
  flex: 1; font-size: 22rpx; font-family: Menlo, Monaco, 'Courier New', monospace;
  color: #e5e6eb; line-height: 1.5; word-break: break-all;
}
.command-copy {
  font-size: 22rpx; font-weight: 600; color: #667eea; flex-shrink: 0;
  padding: 6rpx 16rpx; background: rgba(102, 126, 234, 0.12); border-radius: 10rpx;
}

.connecting { display: flex; align-items: center; gap: 12rpx; margin-top: 8rpx; }
.connecting-dots { display: flex; gap: 8rpx; }
.connecting-dots view {
  width: 10rpx; height: 10rpx; border-radius: 50%; background: #667eea;
  animation: dot-breathe 1.5s ease-in-out infinite;
}
.connecting-dots view:nth-child(2) { animation-delay: 0.2s; }
.connecting-dots view:nth-child(3) { animation-delay: 0.4s; }
@keyframes dot-breathe {
  0%, 100% { opacity: 0.3; transform: scale(0.8); }
  50% { opacity: 1; transform: scale(1); }
}
.connecting-text { font-size: 22rpx; color: #86909c; }
.connected-text { font-size: 24rpx; color: #00b42a; font-weight: 600; }

.setup-success { display: flex; flex-direction: column; align-items: center; padding: 20rpx 0; }
.success-icon {
  width: 72rpx; height: 72rpx; margin-bottom: 20rpx;
  background-image: url(data:image/svg+xml;base64,);
  background-size: contain; background-repeat: no-repeat;
}
.success-title { font-size: 30rpx; font-weight: 700; color: #00b42a; }
.success-hint { font-size: 24rpx; color: #86909c; margin-top: 8rpx; }

.setup-error {
  display: flex; flex-direction: column; align-items: center; gap: 16rpx;
  margin-top: 20rpx; font-size: 24rpx; color: #f53f3f;
}

.setup-contact {
  text-align: center; margin-top: 20rpx;
}
.retry-btn {
  font-size: 24rpx; font-weight: 600; color: #667eea;
  padding: 8rpx 24rpx; border: 1rpx solid rgba(102, 126, 234, 0.3); border-radius: 20rpx;
}

.setup-reset { text-align: center; margin-top: 24rpx; }
.reset-btn {
  font-size: 24rpx; color: #86909c;
  padding: 8rpx 24rpx; border: 1rpx solid rgba(0,0,0,0.08); border-radius: 20rpx;
}

.setup-footer { margin-top: 40rpx; text-align: center; }
.footer-slogan { font-size: 22rpx; color: rgba(255, 255, 255, 0.5); }

.setup-reset .troubleshoot-btn { margin-left: 16rpx; }

/* ── Troubleshoot modal ── */

.troubleshoot-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.45); z-index: 999;
  display: flex; align-items: flex-end; justify-content: center;
}

.troubleshoot-panel {
  width: 100%; max-height: 80vh; background: #fff;
  border-radius: 32rpx 32rpx 0 0; overflow: hidden;
}

.ts-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 32rpx 36rpx 20rpx; border-bottom: 0.5rpx solid #f2f3f5;
}

.ts-title { font-size: 32rpx; font-weight: 700; color: #1d2129; }
.ts-close { font-size: 32rpx; color: #86909c; padding: 8rpx; }

.ts-body { padding: 24rpx 36rpx 48rpx; max-height: 70vh; }

.ts-section { margin-bottom: 32rpx; }

.ts-section-title {
  font-size: 28rpx; font-weight: 600; color: #1d2129;
  margin-bottom: 12rpx; display: block;
}

.ts-key-box, .ts-cmd-box {
  display: flex; align-items: center; justify-content: space-between;
  background: #f7f8fa; border-radius: 12rpx; padding: 16rpx 20rpx;
  margin-bottom: 12rpx;
}

.ts-key-text, .ts-cmd-text {
  font-size: 24rpx; color: #1d2129; font-family: monospace;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  flex: 1; margin-right: 16rpx;
}

.ts-copy-btn {
  font-size: 24rpx; color: #667eea; font-weight: 500; flex-shrink: 0;
}

.ts-hint {
  font-size: 24rpx; color: #86909c; display: block; margin-bottom: 4rpx;
  line-height: 1.6;
}

.ts-retry-btn {
  display: inline-block; margin-top: 12rpx;
  background: #667eea; color: #fff; font-size: 28rpx; font-weight: 500;
  padding: 16rpx 48rpx; border-radius: 12rpx;
}
