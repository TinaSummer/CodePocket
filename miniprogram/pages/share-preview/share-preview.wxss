/* Share preview page — clean, no wallpaper */

.preview-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: transparent;
}

/* ── Loading ── */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
  gap: 24rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #e5e6eb;
  border-top-color: #667eea;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.loading-text {
  font-size: 28rpx;
  color: #86909c;
}

/* ── Scroll area ── */
.preview-scroll {
  flex: 1;
  padding: 20rpx 24rpx;
}

/* ── Session divider ── */
.preview-session {
  margin-bottom: 32rpx;
}

.session-divider {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding: 24rpx 16rpx;
  margin-bottom: 16rpx;
  background: #fff;
  border-radius: 12rpx;
  border-left: 6rpx solid #667eea;
}

.session-divider-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1d2129;
}

.session-divider-meta {
  font-size: 22rpx;
  color: #86909c;
}

/* ── Messages ── */
.msg { margin-bottom: 24rpx; padding: 0 16rpx; box-sizing: border-box; }
.msg.user { display: flex; flex-direction: column; align-items: flex-end; padding: 0 24rpx 0 0; }
.msg.agent { display: flex; flex-direction: column; align-items: flex-start; padding: 0 40rpx 0 16rpx; }

.msg-blocks { max-width: 100%; width: 100%; overflow: hidden; }
.msg-text-block { position: relative; }
.msg-content { max-width: 100%; overflow: hidden; }
.msg.agent .msg-content > view { margin-bottom: 8rpx; }

.msg-text { font-size: 28rpx; line-height: 1.75; color: #1d2129; word-break: break-word; }
.msg-heading { font-size: 32rpx; font-weight: 700; color: #1d2129; margin-top: 20rpx; margin-bottom: 8rpx; line-height: 1.5; }
.msg-table { width: 100%; margin: 12rpx 0; overflow-x: auto; }
.msg-list-item { display: flex; align-items: flex-start; gap: 12rpx; padding-left: 16rpx; margin: 4rpx 0; font-size: 28rpx; line-height: 1.7; color: #1d2129; }
.list-dot { color: #86909c; flex-shrink: 0; margin-top: 2rpx; }
.list-text { flex: 1; font-size: 28rpx; line-height: 1.7; color: #1d2129; }

/* Code blocks */
.code-block { background: #f6f8fa; border-radius: 12rpx; margin: 16rpx 0; overflow: hidden; }
.code-header { display: flex; padding: 12rpx 20rpx; border-bottom: 1rpx solid rgba(0,0,0,0.06); }
.code-lang { font-size: 22rpx; font-family: 'SF Mono', Menlo, Monaco, monospace; color: #86909c; }
.code-text { padding: 20rpx; overflow-x: auto; }
.code-text text { font-size: 24rpx; font-family: 'SF Mono', Menlo, Monaco, monospace; line-height: 1.6; color: #1d2129; white-space: pre-wrap; word-break: break-all; }

/* Thinking block */
.thinking-block { width: 100%; }
.thinking-block-divider { border: none; border-top: 1rpx solid #e5e6eb; margin: 8rpx 0; }
.thinking-block-header { display: flex; align-items: center; gap: 10rpx; padding: 6rpx 0; }
.thinking-block-header:active { opacity: 0.7; }
.thinking-block-arrow { width: 0; height: 0; border-left: 10rpx solid #86909c; border-top: 6rpx solid transparent; border-bottom: 6rpx solid transparent; flex-shrink: 0; transition: transform 0.2s ease; }
.thinking-block-arrow.expanded { transform: rotate(90deg); }
.thinking-block-summary { font-size: 22rpx; color: #86909c; font-style: italic; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex: 1; }
.thinking-block-body { padding: 12rpx 16rpx; font-size: 24rpx; color: #4e5969; line-height: 1.6; }

/* Tool group */
.tool-group { margin: 12rpx 0; }
.tool-group-header { display: flex; align-items: center; gap: 10rpx; padding: 10rpx 16rpx; }
.tool-group-icon { width: 36rpx; height: 36rpx; border-radius: 50%; background: #f2f3f5; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.tool-group-icon text { font-size: 20rpx; font-weight: 600; color: #86909c; }
.tool-group-label { font-size: 24rpx; color: #86909c; font-weight: 500; }

/* Tool call card */
.tool-card { margin: 8rpx 0; background: transparent; }
.tool-card-header { display: flex; align-items: center; gap: 12rpx; padding: 12rpx 16rpx; }
.tool-status-dot { width: 16rpx; height: 16rpx; border-radius: 50%; flex-shrink: 0; }
.tool-status-dot.running { background: #667eea; }
.tool-status-dot.completed { background: #00a856; }
.tool-status-dot.approved { background: #00a856; }
.tool-name { font-size: 24rpx; font-family: 'SF Mono', Menlo, Monaco, monospace; font-weight: 500; color: #4e5969; flex-shrink: 0; }
.tool-param-summary { font-size: 22rpx; font-family: 'SF Mono', Menlo, Monaco, monospace; color: #86909c; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex: 1; min-width: 0; }

/* Tool group expandable */
.tool-chevron { width: 0; height: 0; border-left: 8rpx solid #86909c; border-top: 5rpx solid transparent; border-bottom: 5rpx solid transparent; flex-shrink: 0; transition: transform 0.2s ease; margin-left: auto; }
.tool-chevron.up { transform: rotate(90deg); }
.tool-group { margin: 12rpx 0; }
.tool-group-header { display: flex; align-items: center; gap: 10rpx; padding: 10rpx 16rpx; }
.tool-group-header:active { opacity: 0.7; }
.tool-group-icon { width: 36rpx; height: 36rpx; border-radius: 50%; background: #f2f3f5; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.tool-group-icon text { font-size: 20rpx; font-weight: 600; color: #86909c; }
.tool-group-label { font-size: 24rpx; color: #86909c; font-weight: 500; flex: 1; }
.tool-group-body { padding-left: 16rpx; }
.tool-group-item-header { display: flex; align-items: center; gap: 10rpx; padding: 8rpx 12rpx; }
.tool-group-item-header:active { opacity: 0.7; }
.tool-result { padding: 8rpx 12rpx; font-size: 22rpx; color: #86909c; max-height: 200rpx; overflow: hidden; }
.tool-result.error { color: #f53f3f; }

/* Permission badge */
.perm-badge { display: inline-flex; padding: 8rpx 20rpx; background: rgba(255,125,0,0.06); border-radius: 20rpx; margin: 8rpx 0; }
.perm-badge-text { font-size: 22rpx; color: #ff7d00; }

/* User bubble */
.msg-bubble-wrapper { display: flex; flex-direction: column; align-items: flex-end; max-width: 85%; margin-right: 24rpx; }
.msg-bubble { max-width: 100%; padding: 18rpx 24rpx; font-size: 28rpx; line-height: 1.7; word-break: break-word; box-sizing: border-box; background: #667eea; border-radius: 20rpx 6rpx 20rpx 20rpx; color: #fff; }

/* Footer */
.preview-footer { display: flex; flex-direction: column; align-items: center; padding: 40rpx 0 20rpx; margin-top: 32rpx; }
.footer-brand { font-size: 28rpx; font-weight: 700; color: #667eea; }
.footer-sub { font-size: 22rpx; color: #86909c; margin-top: 8rpx; }

/* Bottom action bar */
.preview-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.action-share {
  background: #07c160;
  color: #fff;
  border: none;
  padding: 0;
  margin: 0;
  line-height: 80rpx;
}

.action-share::after {
  border: none;
}

.action-save {
  background: #667eea;
  color: #fff;
}

.action-save:active {
  opacity: 0.85;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to   { transform: rotate(360deg); }
}
