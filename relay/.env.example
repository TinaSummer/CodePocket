# ─────────────────────────────────────────────────────
# CodePocket Relay 配置
#
# 使用方式:
#   - systemd 部署: 写入 /etc/codepocket-relay.env (root:root, 600)
#   - PM2 部署:    在 ecosystem.config.js 里引用,或 export 后启动
#   - 开发:        复制为 .env,用 bun run src/index.ts
# ─────────────────────────────────────────────────────

# ── 必填 ──

# 服务端口 (Nginx/Caddy 反代到此端口)
RELAY_PORT=3010

# 注册密钥 (用户连接时需要)
# 生成: openssl rand -hex 32
RELAY_KEYS=your-relay-key-here

# ── 可选: 微信登录 ──
# 不填则跳过 wx.login 校验,只用 RELAY_KEYS 做认证
# 自部署用户使用 published 小程序时通常填小程序所有者的 AppID/Secret
WX_APPID=
WX_SECRET=

# ── 可选: 管理员 openid 白名单 ──
# 逗号分隔的微信 openid 列表,匹配的用户打开设置页会自动解锁管理员功能
# 如何获取:服务器上 cat /opt/codepocket-relay/data/keys.json 看自己的 openId 字段
# 不填则只能用长按版本号 + 粘贴 RELAY_KEYS 的方式登录管理员
ADMIN_OPENIDS=

# ── 可选: 文件存储 (腾讯云 COS) ──
# 不填则禁用图片/文件上传,小程序分享对话等功能会降级
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-shanghai
COS_BUCKET=
# COS_BUCKET_URL 留空则自动拼成 https://${COS_BUCKET}.cos.${COS_REGION}.myqcloud.com
COS_BUCKET_URL=

# ── 可选: 数据目录 ──
DATA_DIR=/opt/codepocket-relay/data

# ── 运行时 ──
NODE_ENV=production
